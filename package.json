    "type": "git",
    "url": "git+https://github.com/yowainwright/yowainwright.github.io"
  },
  "type": "module",
  "main": "README.md",
  "scripts": {
    "build": "tsx scripts/run-task.ts build",
    "update-pricing": "tsx scripts/update-ai-pricing/index.ts",
    "build:search": "tsx scripts/generate-search-data.ts",
    "build:local": "tsx scripts/run-task.ts build-local",
    "build:vinext": "vite build --mode native",
    "build:redact": "vite build --mode redact",
    "build:rss": "tsx scripts/rss/index.ts",
    "build:css": "tsx scripts/run-task.ts build-css",
    "playwright:install": "playwright install chromium --with-deps",
    "dev": "mprocs",
    "dev:next": "next dev --port 34729",
    "dev:vinext": "vinext dev --port 34730",
    "dev:css": "tsx scripts/run-task.ts dev-css",
    "generate:component-styles": "tsx scripts/generate-component-styles.ts",
    "typecheck:watch": "tsc --noEmit --watch --pretty",
    "watch:pricing": "tsx scripts/watch-ai-pricing.ts",
    "full-rebuild": "tsx scripts/run-task.ts full-rebuild",
    "format": "oxfmt --write \"**/*.{js,jsx,ts,tsx}\" \"!node_modules/**\" \"!public/**\" \"!out/**\" \"!dist/**\" \"!tmp/**\" \"!content/**\" --threads=1",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx}\" \"!node_modules/**\" \"!public/**\" \"!out/**\" \"!dist/**\" \"!tmp/**\" \"!content/**\" --threads=1",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json . --fix",
    "test": "vitest run",
    "test:runtime": "playwright test",
    "skills:install": "tsx scripts/install/index.ts skills",
    "review:content": "tsx scripts/review-content.ts",
    "review:prose": "tsx scripts/review-prose/index.ts",
    "prepare": "tsx scripts/install/index.ts all",
    "start": "vinext start --port 34729",
    "update": "tsx scripts/run-task.ts update",
    "update:packages": "codependence --config package.json --update",
    "update:actions": "codependence --config .codependencerc --update",
    "maintain": "pastoralist --checkSecurity --forceSecurityRefactor --remove-unused --strict"
  },
