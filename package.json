          "addedDate": "2026-11-11T04:47:05Z",
          "source": "manual",
          "reason": {
            "type": "project",
            "summary": "Redact 0.3.1 requires exactly Vinext 1.3.0; its static export also needs page-data JSON for client navigation on GitHub Pages.",
            "pin": "1.3.0",
            "patch": "patches/vinext@1.3.0.patch",
            "constraints": [
              "The Redact adapter rejects Vinext versions other than 1.3.0.",
              "Keep the exporter patch until a supported release passes static client-navigation tests without it."
            ],
            "references": [
              "https://tanstack.com/redact/latest/docs/vinext"
            ]
          },
          "keep": {
            "reason": "Retain this compatibility override until Redact supports a newer Vinext release and the static navigation checks pass."
          }
        }
