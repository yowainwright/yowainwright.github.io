{
  "name": "Jeffry.in",
  "version": "2.13.0",
  "private": true,
  "description": "Jeffry.in, Jeff Wainwright's blog",
  "homepage": "https://github.com/yowainwright/yowainwright.github.io#readme",
  "bugs": {
    "url": "https://github.com/yowainwright/yowainwright.github.io/issues"
  },
  "license": "MIT",
  "author": "Jeff Wainwright <yowainwright@gmail.com> (jeffry.in)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/yowainwright.github.io"
  },
  "type": "module",
  "main": "README.md",
  "scripts": {
    "build": "tsx scripts/run-task.ts build",
    "update-pricing": "tsx scripts/update-ai-pricing/index.ts",
    "build:search": "tsx scripts/generate-search-data.ts",
    "build:local": "tsx scripts/run-task.ts build-local",
    "build:rss": "tsx scripts/rss/index.ts",
    "build:css": "tsx scripts/run-task.ts build-css",
    "playwright:install": "playwright install chromium --with-deps",
    "dev": "mprocs",
    "dev:next": "next dev --port 34729",
    "dev:css": "tsx scripts/run-task.ts dev-css",
    "generate:component-styles": "tsx scripts/generate-component-styles.ts",
    "typecheck:watch": "tsc --noEmit --watch --pretty",
    "watch:pricing": "tsx scripts/watch-ai-pricing.ts",
    "full-rebuild": "tsx scripts/run-task.ts full-rebuild",
    "format": "oxfmt --write \"**/*.{js,jsx,ts,tsx}\" \"!node_modules/**\" \"!public/**\" \"!out/**\" \"!tmp/**\" \"!content/**\" --threads=1",
    "format:check": "oxfmt --check \"**/*.{js,jsx,ts,tsx}\" \"!node_modules/**\" \"!public/**\" \"!out/**\" \"!tmp/**\" \"!content/**\" --threads=1",
    "lint": "oxlint -c .oxlintrc.json .",
    "lint:fix": "oxlint -c .oxlintrc.json . --fix",
    "test": "vitest run",
    "prepare": "tsx scripts/install-hooks.ts",
    "start": "next start",
    "update": "tsx scripts/run-task.ts update",
    "update:packages": "codependence --config package.json --update",
    "update:actions": "codependence --config .codependencerc --update",
    "maintain": "pastoralist"
  },
  "dependencies": {
    "@atproto/api": "0.18.9",
    "@automattic/social-previews": "3.0.0",
    "@giscus/react": "3.1.0",
    "@keystatic/core": "0.5.48",
    "@keystatic/next": "5.0.4",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.0",
    "@next/third-parties": "16.3.0",
    "@sentry/nextjs": "10.69.0",
    "effect": "3.21.2",
    "firebase": "12.17.0",
    "fuse.js": "7.1.0",
    "lucide-react": "0.542.0",
    "next": "16.3.6",
    "next-mdx-remote": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-zoom-pan-pinch": "3.7.0",
    "recharts": "3.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@shikijs/colorized-brackets": "1.29.2",
    "@shikijs/rehype": "1.29.2",
    "@shikijs/transformers": "1.29.2",
    "@types/hast": "3.0.5",
    "@types/jsdom": "27.0.0",
    "@types/mdast": "4.0.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/unist": "3.0.3",
    "@vercel/og": "0.8.6",
    "codependence": "1.0.8",
    "gray-matter": "4.0.3",
    "jsdom": "28.0.0",
    "mermaid-isomorphic": "3.1.0",
    "oxfmt": "0.50.0",
    "oxlint": "1.67.0",
    "pastoralist": "1.13.0",
    "pino": "10.1.0",
    "pino-pretty": "13.1.3",
    "playwright": "1.57.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "rxjs": "7.8.2",
    "sanitize-filename": "1.6.4",
    "sass": "1.102.0",
    "shiki": "1.29.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.7.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0",
    "pnpm": ">=11.18.0 <12.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "codependence": {
    "mode": "verbose",
    "codependencies": [
      "@next/mdx",
      "@next/third-parties",
      "@sentry/nextjs",
      "firebase",
      "gray-matter",
      "next",
      "react",
      "react-dom",
      "rehype-stringify",
      "remark-rehype",
      "sanitize-filename",
      "unist-util-visit",
      "@giscus/react",
      "@types/react",
      "@types/react-dom",
      "codependence",
      "pastoralist",
      "sass"
    ]
  },
  "pastoralist": {
    "overrideSource": "pnpm-workspace.yaml",
    "checkSecurity": true,
    "appendix": {
      "protobufjs@7.6.4": {
        "dependents": {
          "Jeffry.in": "protobufjs (required by @grpc/proto-loader)"
        },
        "ledger": {
          "addedDate": "2026-07-14T04:04:34Z",
          "reason": "Security fix for arbitrary code execution in protobufjs (critical)",
          "source": "security",
          "securityChecked": true,
          "securityCheckDate": "2026-07-14T04:04:34Z",
          "securityCheckResult": "clean",
          "securityProvider": "github",
          "cves": [
            "CVE-2026-41242"
          ],
          "severity": "critical",
          "vulnerableRange": "<=7.5.4",
          "patchedVersion": "7.5.5"
        }
      },
      "@grpc/grpc-js@1.9.16": {
        "dependents": {
          "Jeffry.in": "@grpc/grpc-js (required by @firebase/firestore)"
        },
        "ledger": {
          "addedDate": "2026-07-14T04:04:34Z",
          "reason": "Security fix for denial of service in @grpc/grpc-js (high)",
          "source": "security",
          "securityChecked": true,
          "securityCheckDate": "2026-07-14T04:04:34Z",
          "securityCheckResult": "clean",
          "securityProvider": "npm",
          "severity": "high",
          "vulnerableRange": "<1.9.16",
          "patchedVersion": "1.9.16"
        }
      },
      "undici@7.29.0": {
        "dependents": {
          "Jeffry.in": "undici (required by jsdom)"
        },
        "ledger": {
          "addedDate": "2026-07-14T04:04:34Z",
          "reason": "Security fixes for high-severity undici vulnerabilities",
          "source": "security",
          "securityChecked": true,
          "securityCheckDate": "2026-08-11T08:58:30Z",
          "securityCheckResult": "clean",
          "securityProvider": "github",
          "cves": [
            "CVE-2026-12151",
            "CVE-2026-13697"
          ],
          "severity": "high",
          "vulnerableRange": ">=7.0.0 <7.29.0",
          "patchedVersion": "7.29.0"
        }
      }
    },
    "security": {
      "enabled": true,
      "provider": [
        "osv",
        "npm"
      ],
      "interactive": false,
      "autoFix": true,
      "severityThreshold": "high",
      "strict": true
    }
  },
  "overrides": {
    "@grpc/grpc-js": "1.9.16",
    "protobufjs": "7.6.4",
    "undici": "7.29.0"
  }
}
