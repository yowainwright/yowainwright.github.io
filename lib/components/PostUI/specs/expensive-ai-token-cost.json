          "Grok 4.1",
          "Gemini 3 Ultra",
          "GPT-5",
          "Claude Opus 4.5"
        ],
        "values": [
          0.0031,
          0.0008,
          0.0096,
          0.084,
          0.2095
        ]
      },
      "children": []
    },
    "token-cost-source-note": {
      "type": "Text",
      "props": {
        "text": "Sources: Artificial Analysis, OpenAI API pricing, and Anthropic API pricing."
      },
      "children": []
    }
  }
}
